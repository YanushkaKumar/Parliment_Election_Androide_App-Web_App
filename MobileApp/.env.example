# Copy to .env.local. Firebase web app config (Firebase console → Project settings → Your apps).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=electionnew-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=electionnew-app
EXPO_PUBLIC_FIREBASE_APP_ID=

# Local testing against the Firebase emulators (10.0.2.2 = host machine from the Android emulator).
EXPO_PUBLIC_USE_EMULATORS=false
EXPO_PUBLIC_EMULATOR_HOST=10.0.2.2
