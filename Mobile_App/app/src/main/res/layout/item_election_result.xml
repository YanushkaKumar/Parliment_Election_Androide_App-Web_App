<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/ivCandidatePhoto"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="Candidate Photo" />

        <ImageView
            android:id="@+id/ivPartySymbol"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@+id/ivCandidatePhoto"
            app:layout_constraintEnd_toEndOf="@+id/ivCandidatePhoto"
            app:layout_constraintTop_toBottomOf="@+id/ivCandidatePhoto"
            android:contentDescription="Party Symbol" />

        <TextView
            android:id="@+id/tvCandidateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvVoteCount"
            app:layout_constraintStart_toEndOf="@+id/ivCandidatePhoto"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sajith Premadasa" />

        <TextView
            android:id="@+id/tvCandidateId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toStartOf="@+id/tvVoteCount"
            app:layout_constraintStart_toStartOf="@+id/tvCandidateName"
            app:layout_constraintTop_toBottomOf="@+id/tvCandidateName"
            tools:text="ID: CAND001" />

        <TextView
            android:id="@+id/tvCandidateParty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/tvVoteCount"
            app:layout_constraintStart_toStartOf="@+id/tvCandidateName"
            app:layout_constraintTop_toBottomOf="@+id/tvCandidateId"
            tools:text="MMP" />

        <TextView
            android:id="@+id/labelDistrict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="District:"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/tvCandidateName"
            app:layout_constraintTop_toBottomOf="@+id/tvCandidateParty" />

        <TextView
            android:id="@+id/tvDistrict"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toStartOf="@+id/tvVoteCount"
            app:layout_constraintStart_toEndOf="@+id/labelDistrict"
            app:layout_constraintTop_toTopOf="@+id/labelDistrict"
            tools:text="Colombo" />

        <TextView
            android:id="@+id/labelConstituency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Constituency:"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/labelDistrict"
            app:layout_constraintTop_toBottomOf="@+id/labelDistrict" />

        <TextView
            android:id="@+id/tvConstituency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toStartOf="@+id/tvVoteCount"
            app:layout_constraintStart_toEndOf="@+id/labelConstituency"
            app:layout_constraintTop_toTopOf="@+id/labelConstituency"
            tools:text="Colombo 02" />

        <TextView
            android:id="@+id/tvVoteCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/vote_count_background"
            android:padding="12dp"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>