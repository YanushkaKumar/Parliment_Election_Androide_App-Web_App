<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:backgroundTint="@android:color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Candidate Photo with Card Background -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/photoCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/purple"
            app:strokeWidth="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivCandidatePhoto"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:scaleType="centerCrop"
                android:contentDescription="Candidate Photo" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Party Symbol with Card Background -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/purple"
            app:strokeWidth="1dp"
            app:layout_constraintStart_toStartOf="@+id/photoCard"
            app:layout_constraintEnd_toEndOf="@+id/photoCard"
            app:layout_constraintTop_toBottomOf="@+id/photoCard">

            <ImageView
                android:id="@+id/ivPartySymbol"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="4dp"
                android:contentDescription="Party Symbol" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvCandidateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="12dp"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/purple"
            app:layout_constraintEnd_toStartOf="@+id/voteCountCard"
            app:layout_constraintStart_toEndOf="@+id/photoCard"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Sajith Premadasa" />

        <TextView
            android:id="@+id/tvCandidateId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textStyle="italic"
            android:textColor="#757575"
            app:layout_constraintEnd_toStartOf="@+id/voteCountCard"
            app:layout_constraintStart_toStartOf="@+id/tvCandidateName"
            app:layout_constraintTop_toBottomOf="@+id/tvCandidateName"
            tools:text="ID: CAND001" />

        <TextView
            android:id="@+id/tvCandidateParty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintEnd_toStartOf="@+id/voteCountCard"
            app:layout_constraintStart_toStartOf="@+id/tvCandidateName"
            app:layout_constraintTop_toBottomOf="@+id/tvCandidateId"
            tools:text="MMP" />

        <TextView
            android:id="@+id/labelDistrict"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="District:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="@+id/tvCandidateName"
            app:layout_constraintTop_toBottomOf="@+id/tvCandidateParty" />

        <TextView
            android:id="@+id/tvDistrict"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="14sp"
            android:textColor="#757575"
            app:layout_constraintEnd_toStartOf="@+id/voteCountCard"
            app:layout_constraintStart_toEndOf="@+id/labelDistrict"
            app:layout_constraintTop_toTopOf="@+id/labelDistrict"
            tools:text="Colombo" />

        <TextView
            android:id="@+id/labelConstituency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Constituency:"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="@+id/labelDistrict"
            app:layout_constraintTop_toBottomOf="@+id/labelDistrict" />

        <TextView
            android:id="@+id/tvConstituency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textSize="14sp"
            android:textColor="#757575"
            app:layout_constraintEnd_toStartOf="@+id/voteCountCard"
            app:layout_constraintStart_toEndOf="@+id/labelConstituency"
            app:layout_constraintTop_toTopOf="@+id/labelConstituency"
            tools:text="Colombo 02" />

        <!-- Vote Count with Material Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/voteCountCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:strokeWidth="0dp"
            android:backgroundTint="@color/purple"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvVoteCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                tools:text="0" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
