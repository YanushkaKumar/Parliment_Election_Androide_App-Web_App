<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/purple"
    app:strokeWidth="2dp"
    app:rippleColor="?attr/colorPrimary"
    app:cardCornerRadius="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Election Name -->
        <TextView
            android:id="@+id/tvElectionName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Presidential Election"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/purple"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Candidate Photo with Card Background -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            app:cardCornerRadius="70dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/purple"
            app:strokeWidth="3dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:id="@+id/ivCandidatePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Candidate Photo" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Candidate ID -->
        <TextView
            android:id="@+id/tvCandidateId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ID: 678"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#757575"
            android:layout_gravity="center"
            android:layout_marginBottom="4dp"/>

        <!-- Candidate Name -->
        <TextView
            android:id="@+id/tvCandidateName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sajith Premadasa"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/black"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Horizontal layout for party info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp">

            <!-- Party Symbol with Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="@color/purple"
                app:strokeWidth="1dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivPartySymbol"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:padding="4dp"
                    android:contentDescription="Party Symbol"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Candidate Party -->
            <TextView
                android:id="@+id/tvCandidateParty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MMP"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/purple"/>
        </LinearLayout>

        <!-- Location Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/purple"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvConstituency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Colombo 02"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" | "
                    android:textSize="14sp"
                    android:textColor="#757575"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>

                <TextView
                    android:id="@+id/tvDistrict"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Colombo"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Vote Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVote"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Vote"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/purple"
            app:cornerRadius="12dp"
            app:elevation="4dp"
            app:icon="@android:drawable/checkbox_on_background"
            app:iconGravity="textStart"
            app:iconPadding="8dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
