{
    "java.configuration.updateBuildConfiguration": "interactive",
    "java.compile.nullAnalysis.mode": "automatic",
    // The React Native android/ folder is generated by Expo and pulls in every React Native
    // Gradle module; importing it makes the Java language server use several GB of RAM.
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/maven/**",
        "**/MobileApp/android/**"
    ]
}
